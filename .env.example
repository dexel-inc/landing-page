# Copiar a .env (local) o configurar en Vercel. Sin estas variables el sitio
# funciona igual, pero no se registra ninguna conversión.

# --- Sitio -----------------------------------------------------------------
# Origen absoluto. Lo usan las URLs canónicas, los hreflang, el sitemap y las
# imágenes de Open Graph, que se generan en el build cuando no hay navegador.
VITE_SITE_URL=https://www.dexel-inc.com

# --- Medición (navegador) --------------------------------------------------
# Google Analytics 4 directo. Alternativa: usar GTM y dejar esta vacía.
VITE_GA4_ID=

# Google Tag Manager, si se prefiere administrar las etiquetas desde ahí.
VITE_GTM_ID=

# Meta Pixel. Necesario para las campañas de Facebook e Instagram.
VITE_META_PIXEL_ID=

# Endpoint de la Conversions API. Con el proyecto en Vercel es esta ruta.
# Vacío = solo se mide con el pixel del navegador.
VITE_META_CAPI_ENDPOINT=/api/meta-capi

# --- Medición (servidor) ---------------------------------------------------
# SIN prefijo VITE_: estas nunca deben llegar al navegador.
# Se configuran en Vercel → Settings → Environment Variables.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Opcional: código de "Eventos de prueba" del Administrador de Eventos de Meta.
META_TEST_EVENT_CODE=
