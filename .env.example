# Medición de conversiones. Copiar a .env y completar con los IDs reales.
# Sin estas variables el sitio funciona igual, pero no se registra nada.

# Google Tag Manager (contiene GA4 dentro)
VITE_GTM_ID=

# Meta Pixel — necesario para las campañas de Facebook/Instagram.
# Recordar configurar además la Conversions API del lado del servidor:
# solo con el pixel se pierde una parte significativa de las conversiones.
VITE_META_PIXEL_ID=
