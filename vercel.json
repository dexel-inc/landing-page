{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/servicios",
      "destination": "/es/servicios",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/es/contacto",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/en/services",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/es/servicios/software-a-la-medida",
      "destination": "/es/servicios/desarrollo-web",
      "permanent": true
    },
    {
      "source": "/es/servicios/presencia-web",
      "destination": "/es/servicios/desarrollo-web",
      "permanent": true
    },
    {
      "source": "/en/services/custom-software",
      "destination": "/en/services/web-development",
      "permanent": true
    },
    {
      "source": "/en/services/web-presence",
      "destination": "/en/services/web-development",
      "permanent": true
    },
    {
      "source": "/en/services/automation-and-integration",
      "destination": "/en/services/automation",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/es/privacidad",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/en/privacy",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|ico|webp|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
